{
  "name": "leetcode-practice-sam56714",
  "displayName": "LeetCode Practice: Spaced Repetition",
  "description": "Solve LeetCode problems in VS Code, with a workflow built around spaced repetition.",
  "version": "0.1.1",
  "publisher": "sam56714",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pg56714/leetcode-practice"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leetcode-practice",
          "title": "LeetCode Practice",
          "icon": "resources/sidebar.svg"
        }
      ],
      "panel": [
        {
          "id": "leetcode-practice-results",
          "title": "LeetCode Results",
          "icon": "resources/sidebar.svg"
        }
      ]
    },
    "views": {
      "leetcode-practice": [
        {
          "id": "leetcodePractice.daily",
          "name": "Daily Challenge"
        },
        {
          "id": "leetcodePractice.problems",
          "name": "Problems"
        },
        {
          "id": "leetcodePractice.studyLists",
          "name": "Study Lists"
        },
        {
          "id": "leetcodePractice.contests",
          "name": "Contests"
        }
      ],
      "leetcode-practice-results": [
        {
          "id": "leetcodePractice.results",
          "name": "Results",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "leetcodePractice.signIn",
        "title": "LeetCode Practice: Sign In",
        "icon": "$(sign-in)"
      },
      {
        "command": "leetcodePractice.signOut",
        "title": "LeetCode Practice: Sign Out"
      },
      {
        "command": "leetcodePractice.refreshDaily",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "leetcodePractice.showOutput",
        "title": "LeetCode Practice: Show Output"
      },
      {
        "command": "leetcodePractice.refreshProblems",
        "title": "Refresh Problems",
        "icon": "$(sync)"
      },
      {
        "command": "leetcodePractice.searchProblems",
        "title": "Search Problems",
        "icon": "$(search)"
      },
      {
        "command": "leetcodePractice.clearProblemSearch",
        "title": "Clear Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "leetcodePractice.openProblem",
        "title": "LeetCode Practice: Open Problem"
      },
      {
        "command": "leetcodePractice.testSolution",
        "title": "LeetCode Practice: Test Solution",
        "icon": "$(play)"
      },
      {
        "command": "leetcodePractice.submitSolution",
        "title": "LeetCode Practice: Submit Solution",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "leetcodePractice.signInWithCookie",
        "title": "LeetCode Practice: Sign In with Cookie"
      },
      {
        "command": "leetcodePractice.changeLanguage",
        "title": "LeetCode Practice: Change Language",
        "icon": "$(code)"
      },
      {
        "command": "leetcodePractice.refreshStudyLists",
        "title": "Refresh Study Lists",
        "icon": "$(refresh)"
      },
      {
        "command": "leetcodePractice.refreshContests",
        "title": "Refresh Contests",
        "icon": "$(refresh)"
      },
      {
        "command": "leetcodePractice.showSolutions",
        "title": "LeetCode Practice: Show Community Solutions",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "leetcodePractice.showStatement",
        "title": "LeetCode Practice: Show Problem Statement",
        "icon": "$(book)"
      },
      {
        "command": "leetcodePractice.changeDefaultLanguage",
        "title": "LeetCode Practice: Change Default Language"
      },
      {
        "command": "leetcodePractice.clearCache",
        "title": "LeetCode Practice: Clear Cache"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "leetcodePractice.refreshDaily",
          "when": "view == leetcodePractice.daily",
          "group": "navigation@1"
        },
        {
          "command": "leetcodePractice.signIn",
          "when": "view == leetcodePractice.daily && !leetcodePractice.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "leetcodePractice.searchProblems",
          "when": "view == leetcodePractice.problems",
          "group": "navigation@1"
        },
        {
          "command": "leetcodePractice.clearProblemSearch",
          "when": "view == leetcodePractice.problems && leetcodePractice.problemsFiltered",
          "group": "navigation@2"
        },
        {
          "command": "leetcodePractice.refreshProblems",
          "when": "view == leetcodePractice.problems",
          "group": "navigation@3"
        },
        {
          "command": "leetcodePractice.refreshStudyLists",
          "when": "view == leetcodePractice.studyLists",
          "group": "navigation@1"
        },
        {
          "command": "leetcodePractice.refreshContests",
          "when": "view == leetcodePractice.contests",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "leetcodePractice.showStatement",
          "when": "leetcodePractice.isSolution",
          "group": "navigation@0"
        },
        {
          "command": "leetcodePractice.changeLanguage",
          "when": "leetcodePractice.isSolution",
          "group": "navigation@0"
        },
        {
          "command": "leetcodePractice.testSolution",
          "when": "leetcodePractice.isSolution",
          "group": "navigation@1"
        },
        {
          "command": "leetcodePractice.submitSolution",
          "when": "leetcodePractice.isSolution",
          "group": "navigation@2"
        },
        {
          "command": "leetcodePractice.showSolutions",
          "when": "leetcodePractice.isSolution",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "leetcodePractice.testSolution",
          "when": "leetcodePractice.isSolution"
        },
        {
          "command": "leetcodePractice.submitSolution",
          "when": "leetcodePractice.isSolution"
        },
        {
          "command": "leetcodePractice.changeLanguage",
          "when": "leetcodePractice.isSolution"
        },
        {
          "command": "leetcodePractice.showStatement",
          "when": "leetcodePractice.isSolution"
        },
        {
          "command": "leetcodePractice.showSolutions",
          "when": "leetcodePractice.isSolution"
        }
      ]
    },
    "configuration": {
      "title": "LeetCode Practice",
      "properties": {
        "leetcodePractice.storagePath": {
          "type": "string",
          "default": "",
          "description": "Where solution folders are created. Defaults to the first workspace folder."
        },
        "leetcodePractice.defaultLanguage": {
          "type": "string",
          "default": "python3",
          "description": "Language slug used when opening a problem (e.g. python3, cpp, rust)."
        },
        "leetcodePractice.studyPlans": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "top-interview-150",
            "leetcode-75",
            "top-100-liked",
            "top-sql-50",
            "programming-skills",
            "dynamic-programming",
            "graph-theory",
            "binary-search",
            "30-days-of-javascript"
          ],
          "markdownDescription": "Study plans to show, by the slug in their URL (`leetcode.com/studyplan/<slug>`). LeetCode has no query that lists the available plans, so they have to be named here."
        }
      }
    },
    "keybindings": [
      {
        "command": "leetcodePractice.testSolution",
        "key": "ctrl+;",
        "mac": "cmd+;",
        "when": "editorTextFocus && leetcodePractice.isSolution"
      },
      {
        "command": "leetcodePractice.submitSolution",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && leetcodePractice.isSolution"
      }
    ]
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:impit --format=cjs --platform=node --sourcemap && node scripts/copy-native-deps.mjs",
    "watch": "bun run compile -- --watch",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:impit --format=cjs --platform=node --minify && node scripts/copy-native-deps.mjs",
    "vscode:prepublish": "bun run package",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src",
    "format": "biome check --write src",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "impit": "^0.14.5",
    "xss": "^1.0.15"
  },
  "icon": "resources/icon.png",
  "keywords": [
    "leetcode",
    "algorithms",
    "interview",
    "practice",
    "spaced repetition"
  ],
  "homepage": "https://github.com/pg56714/leetcode-practice#readme",
  "bugs": {
    "url": "https://github.com/pg56714/leetcode-practice/issues"
  },
  "preview": true
}
